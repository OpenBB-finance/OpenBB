{
  "version": "1.0",
  "description": "Daily business regression cases for OpenBB API auto-provider strategy.",
  "cases": [
    {
      "id": "equity_aapl_1m_auto",
      "question_zh": "查询苹果最近一个月日线，要求系统自动选择数据源。",
      "question_en": "Fetch AAPL daily prices for the last month with automatic provider selection.",
      "method": "GET",
      "path": "/api/v1/equity/price/historical",
      "params": {
        "symbol": "AAPL",
        "start_date": "2025-01-02",
        "end_date": "2025-01-10"
      },
      "expect": {
        "min_results": 1,
        "require_meta": true,
        "expected_provider_requested": "auto",
        "expected_selection_mode": "auto"
      }
    },
