{
  "stl_fred_md_federal_reserve_obb": {
    "name": "FRED-MD Monthly Macro Panel, St. Louis Fed",
    "description": "The McCracken-Ng monthly database of 120+ U.S. macroeconomic series as a wide panel, one column per series.",
    "category": "Federal Reserve",
    "type": "table",
    "widgetId": "stl_fred_md_federal_reserve_obb",
    "mcp_tool": {
      "mcp_server": "Open Data Platform",
      "tool_id": "stl_fred_md"
    },
    "params": [
      {
        "label": "Series",
        "description": "Comma-separated FRED series codes (panel columns) to return; the default returns every series.",
        "optional": true,
        "type": "text",
        "value": null,
        "show": true,
        "paramName": "series"
      },
      {
        "label": "Transform",
        "description": "Apply each series' recommended stationarity transformation (its transform code) instead of returning raw levels.",
        "optional": true,
        "type": "boolean",
        "value": false,
        "show": true,
        "paramName": "transform"
      },
      {
        "label": "Start Date",
        "description": "Start date of the data, in YYYY-MM-DD format.",
        "optional": true,
        "type": "date",
        "value": null,
        "show": true,
        "paramName": "start_date"
      },
      {
        "label": "End Date",
        "description": "End date of the data, in YYYY-MM-DD format.",
        "optional": true,
        "type": "date",
        "value": null,
        "show": true,
        "paramName": "end_date"
      },
      {
        "paramName": "provider",
        "value": "federal_reserve",
        "show": false
      }
    ],
    "endpoint": "fred_md",
    "runButton": false,
    "gridData": {
      "w": 40,
      "h": 20
    },
    "data": {
      "dataKey": "results",
      "table": {
        "showAll": true,
        "columnsDefs": [
          {
            "field": "date",
            "pinned": "left",
            "formatterFn": null,
            "headerName": "Date",
            "headerTooltip": "The observation date.",
            "cellDataType": "date",
            "sort": "desc"
          }
        ],
        "enableAdvanced": true
      }
    },
    "source": [
      "Federal Reserve"
    ],
    "subCategory": "Saint Louis"
  },
