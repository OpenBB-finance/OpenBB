{
  "cleveland_inflation_expectations_federal_reserve_obb": {
    "name": "Cleveland Fed Inflation Expectations",
    "description": "Model-based estimates of expected average annual inflation and the implied real interest rate, by horizon.",
    "category": "Federal Reserve",
    "type": "table",
    "widgetId": "cleveland_inflation_expectations_federal_reserve_obb",
    "mcp_tool": {
      "mcp_server": "Open Data Platform",
      "tool_id": "cleveland_inflation_expectations"
    },
    "params": [
      {
        "label": "Table",
        "description": "Model-implied expected inflation by horizon, the model's real interest rate by horizon, or the ten-year decomposition into expected inflation, real risk premium, and inflation risk premium.",
        "optional": true,
        "type": "text",
        "value": "expected_inflation",
        "show": true,
        "options": [
          {
            "label": "Expected Inflation",
            "value": "expected_inflation"
          },
          {
            "label": "Real Interest Rate",
            "value": "real_interest_rate"
          },
          {
            "label": "Ten-year Expected Chart",
            "value": "ten_year_decomposition"
          }
        ],
        "paramName": "table"
      },
      {
        "label": "Start Date",
        "description": "Start date of the data, in YYYY-MM-DD format.",
        "optional": true,
        "type": "date",
        "value": null,
        "show": true,
        "paramName": "start_date"
      },
      {
        "label": "End Date",
        "description": "End date of the data, in YYYY-MM-DD format.",
        "optional": true,
        "type": "date",
        "value": null,
        "show": true,
        "paramName": "end_date"
      },
      {
        "paramName": "provider",
        "value": "federal_reserve",
        "show": false
      }
    ],
    "endpoint": "inflation_expectations",
    "runButton": false,
    "gridData": {
      "w": 40,
      "h": 20
    },
    "data": {
      "dataKey": "results",
      "table": {
        "showAll": true,
        "columnsDefs": [
          {
            "field": "date",
            "pinned": "left",
            "formatterFn": null,
            "headerName": "Date",
            "headerTooltip": "The model output month.",
            "cellDataType": "date",
            "sort": "desc"
          }
        ],
        "enableAdvanced": true
