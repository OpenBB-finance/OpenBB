            "w": 40,
            "h": 12,
            "state": {
              "columnState": {
                "default": {
                  "sort": {
                    "sortModel": [
                      {
                        "colId": "market_cap",
                        "sort": "desc"
                      }
                    ]
                  },
                  "columnPinning": {
                    "leftColIds": [
                      "symbol",
                      "name",
                      "period_ending"
                    ],
                    "rightColIds": []
